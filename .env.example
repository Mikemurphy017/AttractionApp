# Attractio environment variables
# Copy to .env.local for local development:  cp .env.example .env.local
# Never commit real keys. On Railway, set these as service variables.
# Keys marked [Phase N] are not needed until that phase.

# ─── App ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated emails that get the Bluestone admin role (Admin screen, all advisors).
ADMIN_EMAILS=
# "mock" = adapters return fixtures and spend no credits. "live" = real provider calls.
ADAPTER_MODE=mock

# ─── Supabase (Postgres + auth) ─────────────────────────────────────────
# Local values come from `pnpm supabase status` after `pnpm supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses row-level security; used by the pipeline and admin jobs.
SUPABASE_SECRET_KEY=
# Direct Postgres connection (migrations, Python prediction service).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ─── Claude API ([Phase 3] why-now text, [Phase 4] TextTonality drafts) ─
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ─── People + email data ([Phase 2]) ────────────────────────────────────
# Primary: people search, enrichment, email verification, job changes, job postings.
APOLLO_API_KEY=
# Backups for people/email data (optional).
PEOPLE_DATA_LABS_API_KEY=
CLAY_API_KEY=
# Backup email verification (optional, pick one).
ZEROBOUNCE_API_KEY=
NEVERBOUNCE_API_KEY=

# ─── Company + liquidity signals ([Phase 2]) ────────────────────────────
# Funding rounds.
CRUNCHBASE_API_KEY=
# SEC EDGAR is free but requires a descriptive User-Agent with a contact email,
# e.g. "Attractio ops@yourfirm.com". Requests without one are blocked.
SEC_EDGAR_USER_AGENT=

# ─── News signals ([Phase 2]) ───────────────────────────────────────────
NEWSAPI_API_KEY=
# GDELT and Google News RSS need no key.

# ─── Prediction service ([Phase 5], Python, /lib/predict) ───────────────
PREDICT_SERVICE_URL=http://127.0.0.1:8000
# Shared secret the Next.js app sends to the prediction service.
PREDICT_SERVICE_TOKEN=

# ─── Nightly jobs ([Phase 2] / [Phase 6]) ───────────────────────────────
# Shared secret the Railway cron sends to the pipeline endpoint.
CRON_SECRET=
# Optional, only if we use Inngest instead of Railway cron.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─── Internal alerts ([Phase 6]) ────────────────────────────────────────
# Error alerts and the daily credit-spend summary go to Bluestone only.
# This is internal ops email. It never goes to prospects.
ALERT_EMAIL_TO=
RESEND_API_KEY=
ALERT_EMAIL_FROM=
