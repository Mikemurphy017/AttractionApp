# Attractio environment variables
# Copy to .env.local for local development:  cp .env.example .env.local
# Never commit real keys. On Railway, set these as service variables.
# Keys marked [Phase N] are not needed until that phase.

# ─── App ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# "mock" = data adapters return fixtures and spend nothing. "live" = real calls.
ADAPTER_MODE=mock

# ─── Database (Postgres on Railway; local Postgres for development) ─────
# On Railway, reference the Postgres service: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://attractio:attractio@127.0.0.1:5432/attractio

# ─── Auth (Better Auth, email + password) ───────────────────────────────
# 32+ random characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The app's public URL (Railway domain in production).
BETTER_AUTH_URL=http://localhost:3000

# ─── Admin bootstrap (used by `pnpm db:seed`) ───────────────────────────
# Creates the Bluestone admin account on first seed, or promotes it if it exists.
ADMIN_EMAIL=
ADMIN_NAME=
# Initial password only; change it after first login. 8+ characters.
ADMIN_PASSWORD=
# Password for the sample logins created by `pnpm db:seed:sample` (local/staging only).
SEED_PASSWORD=

# ─── Claude API ([Phase 3] why-now text, [Phase 4] TextTonality drafts) ─
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ─── Public data sources ([Phase 2]) ────────────────────────────────────
# SEC EDGAR (Form D, 8-K, S-1, Form 4) is free but requires a descriptive
# User-Agent with a contact email, e.g. "Attractio ops@yourfirm.com".
SEC_EDGAR_USER_AGENT=
# GDELT and Google News RSS need no key.

# ─── Contact data ([Phase 2], provider not chosen yet) ──────────────────
# Public data has no verified emails or LinkedIn URLs. Fill in whichever
# provider Bluestone picks; leave the rest blank.
EMAIL_VERIFIER_API_KEY=

# ─── Prediction service ([Phase 5], Python, /lib/predict) ───────────────
PREDICT_SERVICE_URL=http://127.0.0.1:8000
# Shared secret the Next.js app sends to the prediction service.
PREDICT_SERVICE_TOKEN=

# ─── Nightly jobs ([Phase 2] / [Phase 6]) ───────────────────────────────
# Shared secret the Railway cron sends to the pipeline endpoint.
CRON_SECRET=

# ─── Internal alerts ([Phase 6]) ────────────────────────────────────────
# Error alerts and the daily credit-spend summary go to Bluestone only.
# This is internal ops email. It never goes to prospects.
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
RESEND_API_KEY=
